{
    "name": "mjoris/router",
    "description": "A lightweight and simple object oriented PHP router, small enough to read and understand. A modernised PHP 8 fork of bramus/router.",
    "keywords": ["router", "routing", "education"],
    "homepage": "https://github.com/mjoris/router",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Joris Maervoet",
            "homepage": "https://github.com/mjoris"
        },
        {
            "name": "Bram(us) Van Damme",
            "email": "bramus@bram.us",
            "homepage": "https://www.bram.us",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/mjoris/router/issues",
        "source": "https://github.com/mjoris/router"
    },
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "autoload": {
        "psr-4": {
            "Mjoris\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mjoris\\Router\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
